{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Sovereign Guardian",
  "version": "0.1.0",
  "identifier": "com.sovereign.guardian",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "beforeDevCommand": "npm run dev --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Sovereign Guardian",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ws://localhost:5175 http://localhost:5175 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "android": {
      "minSdkVersion": 26
    }
  }
}
